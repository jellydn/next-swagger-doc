{
  "name": "next-swagger-doc",
  "version": "0.5.0",
  "keywords": [
    "next-swagger",
    "next-swagger-doc",
    "nextjs",
    "swagger",
    "swagger-jsdoc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jellydn/next-swagger-doc"
  },
  "license": "MIT",
  "author": "Huynh Duc Dung",
  "type": "module",
  "exports": {
    "require": "./dist/index.cjs",
    "import": "./dist/index.js"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "bin": {
    "next-swagger-doc-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pkgroll",
    "coverage": "vitest run --coverage",
    "format": "biome format src",
    "lint": "biome lint src",
    "prepare": "pkgroll",
    "release:version": "bumpp --release conventional --yes --commit \"chore: release v%s\" --tag \"v%s\" --push",
    "start": "pkgroll --watch",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "vercel-build": "npx typedoc src/index.ts"
  },
  "dependencies": {
    "@types/swagger-jsdoc": "6.0.4",
    "cleye": "2.6.0",
    "es-module-lexer": "2.3.2",
    "isarray": "2.0.5",
    "swagger-jsdoc": "6.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@skypack/package-check": "0.2.2",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "all-contributors-cli": "6.26.1",
    "bumpp": "12.2.2",
    "c8": "12.0.0",
    "next": "16.3.3",
    "pkgroll": "2.27.1",
    "size-limit": "13.0.3",
    "sort-package-json": "4.0.0",
    "tslib": "2.8.1",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "next": ">=9"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "sharp"
    ]
  }
}
