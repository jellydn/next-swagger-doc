#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
  local name="$1"
  shift
  local start
  start="$(date +%s)"
  echo "==> $name"
  "$@"
  echo "<== $name completed in $(( $(date +%s) - start ))s"
}

if ! command -v node >/dev/null; then
  echo "Node.js 18 or newer is required." >&2
  exit 1
fi

node_major="$(node -p 'process.versions.node.split(".")[0]')"
if (( node_major < 18 )); then
  echo "Node.js 18 or newer is required; found $(node --version)." >&2
  exit 1
fi

if ! command -v corepack >/dev/null; then
  echo "Corepack is required to activate pnpm 10.9.0." >&2
  exit 1
fi

run_step "Activating pnpm 10.9.0" corepack enable
run_step "Installing dependencies" corepack pnpm@10.9.0 install --frozen-lockfile
