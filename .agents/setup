#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
  local name="$1"
  shift
  local start
  start="$(date +%s)"
  echo "==> $name"
  "$@"
  echo "<== $name completed in $(( $(date +%s) - start ))s"
}

if ! command -v node >/dev/null; then
  echo "Contributor tools require Node.js 22.22+, 24.5+, or 26+." >&2
  exit 1
fi

if ! node -e '
  const [major, minor] = process.versions.node.split(".").map(Number);
  process.exit((major === 22 && minor >= 22) ||
    (major === 24 && minor >= 5) || major >= 26 ? 0 : 1);
'; then
  echo "Contributor tools require Node.js 22.22+, 24.5+, or 26+; found $(node --version)." >&2
  exit 1
fi

if ! command -v npm >/dev/null; then
  echo "npm is required to run the pinned pnpm version." >&2
  exit 1
fi

package_manager="$(node -p 'require("./package.json").packageManager')"
# npm exec also works with pnpm 12 on machines with an older Corepack shim.
run_step "Installing dependencies with $package_manager" \
  env CI=true npm exec --yes --package="$package_manager" -- \
  pnpm install --frozen-lockfile
